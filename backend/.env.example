# Copy this file to .env and fill in your own values. Never commit .env.
# Local dev uses your own Postgres (see README/phase notes). Production uses DATABASE_URL.

# Full connection string (preferred). Example shape only, not a real value:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/delivery_platform_dev
DATABASE_URL=

# ...or the separate parts (used only when DATABASE_URL is empty):
DB_HOST=localhost
DB_PORT=5433
DB_NAME=delivery_platform_dev
DB_USER=
DB_PASS=

# Random long string. Generate one, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
